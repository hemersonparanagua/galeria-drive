# Copie este arquivo como referência e configure os valores reais em
# Vercel → Project → Settings → Environment Variables. NUNCA comite um
# arquivo .env com valores reais neste repositório público.

# Conta de serviço do Google (crie em console.cloud.google.com → IAM → Service Accounts,
# ative a Drive API, e compartilhe a pasta/arquivo relevantes com o e-mail dela).
GOOGLE_SERVICE_ACCOUNT_EMAIL=nome@projeto.iam.gserviceaccount.com
# Pegue o campo "private_key" do JSON baixado e rode: echo -n "$PRIVATE_KEY" | base64 -w0
GOOGLE_SERVICE_ACCOUNT_KEY=

# ID de um arquivo .json vazio ("[]") criado no Drive, de propriedade da conta de
# serviço (ou compartilhado com ela como editor). Esse arquivo é o "banco" do catálogo.
GOOGLE_CATALOG_FILE_ID=

# Token que você vai digitar no painel /admin.html para entrar. Escolha algo longo
# e aleatório; trocar este valor revoga o acesso imediatamente.
ADMIN_TOKEN=
